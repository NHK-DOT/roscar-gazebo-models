<?xml version="1.0"?>
<sdf version="1.7">
  <world name="model_gallery">
    <gravity>0 0 -9.8</gravity>
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.72 0.77 0.82 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.45 0.25 -0.86</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <model name="gallery_floor">
      <static>true</static>
      <link name="floor">
        <collision name="collision">
          <pose>0 0 -0.035 0 0 0</pose>
          <geometry><box><size>11 8 0.06</size></box></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 -0.035 0 0 0</pose>
          <geometry><box><size>11 8 0.06</size></box></geometry>
          <material>
            <ambient>0.24 0.27 0.29 1</ambient>
            <diffuse>0.42 0.46 0.48 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- The two full-size terrain textures are shown side by side. -->
    <include>
      <uri>model://map_plane</uri>
      <name>terrain_original_map_plane</name>
      <pose>-2.3 2.25 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://map_walls</uri>
      <name>competition_map_walls</name>
      <pose>-2.3 2.25 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://my_ground_plane</uri>
      <name>terrain_route_ground</name>
      <pose>2.3 2.25 0.004 0 0 0</pose>
    </include>

    <!-- Competition perception targets face the gallery camera at negative Y. -->
    <include>
      <uri>model://ro1</uri>
      <name>competition_person_board_1</name>
      <pose>-4.25 -1.25 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://ro2</uri>
      <name>competition_person_board_2</name>
      <pose>-3.05 -1.25 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://cp</uri>
      <name>competition_car_plate_board</name>
      <pose>-1.95 -1.25 0 0 0 0</pose>
    </include>

    <!-- One gantry with all three emissive overlays demonstrates the complete assembly. -->
    <include>
      <uri>model://traffic_light</uri>
      <name>competition_horizontal_traffic_light</name>
      <pose>-0.65 -1.25 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://traffic_light_red_lens</uri>
      <name>competition_red_lens</name>
      <pose>-0.65 -1.25 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://traffic_light_yellow_lens</uri>
      <name>competition_yellow_lens</name>
      <pose>-0.65 -1.25 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://traffic_light_green_lens</uri>
      <name>competition_green_lens</name>
      <pose>-0.65 -1.25 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://competition_car</uri>
      <name>competition_car</name>
      <pose>0.75 -1.25 0.02 0 0 3.141593</pose>
    </include>

    <gui fullscreen="0">
      <camera name="gallery_camera">
        <pose>7.6 -9.2 6.3 0 0.48 2.28</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
  </world>
</sdf>

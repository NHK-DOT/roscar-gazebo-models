  <!-- ============ 激光雷达支撑杆参数 ========================== -->
  <!-- 支撑杆半径 -->
  <!-- 支撑杆质量，影响动力学特性 -->
  <link name="support">
    <visual>
      <geometry>
        <cylinder length="0.12" radius="0.01"/>
      </geometry>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
